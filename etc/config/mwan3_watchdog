config globals 'globals'
    option enabled '1'
    option check_interval '60'
    option stabilize_interval '15'
    option stabilize_seconds '30'
    option failure_threshold '2'
    option heal_cooldown '30'
    option heal_retry_interval '15'
    option heal_settle '5'
    option heal_stop_sleep '2'
    option heal_timeout '30'
    option max_heal_attempts '2'
    option heal_sequence 'restart stop_start'
    option heal_flush_conntrack '0'
    option max_global_heals '3'
    option global_heal_window '300'
    option global_mute_time '300'
    option lock_stale_seconds '300'
    option probe_success_percent '80'
    option verify_count '3'
    option verify_timeout '2'
    option max_parallel_workers '2'
    option worker_timeout '90'
    option auto_enable '0'
    option logger_tag 'mwan3_watchdog'
    option mwan3_init '/etc/init.d/mwan3'
    option track_status_dir '/var/run/mwan3track'
    option rtmon_pattern '/usr/sbin/mwan3rtmon'